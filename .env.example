# Supabase Configuration
# Never put a secret or service_role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
# The project's publishable key, which starts with sb_publishable_ and is public by design
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_ENDPOINT=

# SMTP Mailer Settings (Server-only secrets; never prefix with NEXT_PUBLIC_, never commit to git)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM is the sender, for example "Club Name <no-reply@yourdomain>", and must be an address your SMTP service allows.
MAIL_FROM=
